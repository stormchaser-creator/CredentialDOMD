{
  "version": 1,
  "about": "G11: paths an agent change may touch only with the owner's merge. A match holds the run for the owner whatever AUTO_MERGE says; the owner merges it with node scripts/ticket-fix/merge.mjs <run-id>. Patterns: ** matches any path, * any name.",
  "paths": [
    { "pattern": "supabase/**", "reason": "database, RLS policies, edge functions and migrations" },
    { "pattern": "scripts/**", "reason": "runner, build, deploy and data scripts" },
    { "pattern": ".github/**", "reason": "CI and deploy" },
    { "pattern": ".githooks/**", "reason": "git hooks" },
    { "pattern": "package.json", "reason": "dependencies and npm scripts" },
    { "pattern": "package-lock.json", "reason": "dependencies" },
    { "pattern": "eslint.config.js", "reason": "lint rules the gates use" },
    { "pattern": "vite.config.js", "reason": "build configuration" },
    { "pattern": "index.html", "reason": "app shell" },
    { "pattern": "netlify.toml", "reason": "hosting configuration" },
    { "pattern": "vercel.json", "reason": "hosting configuration" },
    { "pattern": "cloudflare/**", "reason": "edge workers" },
    { "pattern": "landing/privacy.html", "reason": "legal page" },
    { "pattern": "landing/terms.html", "reason": "legal page" },
    { "pattern": "landing/security.html", "reason": "legal page" },
    { "pattern": "public/privacy.html", "reason": "legal page" },
    { "pattern": "public/terms.html", "reason": "legal page" },
    { "pattern": "src/content/legalText.js", "reason": "legal text" },
    { "pattern": "src/components/pages/LegalSection.jsx", "reason": "legal text" },
    { "pattern": "src/main.jsx", "reason": "auth provider setup" },
    { "pattern": "src/lib/supabase.js", "reason": "auth client and the sync table registry" },
    { "pattern": "src/lib/admin.js", "reason": "admin access" },
    { "pattern": "src/utils/admin*.js", "reason": "admin access" },
    { "pattern": "src/components/pages/Admin*.jsx", "reason": "admin access" },
    { "pattern": "src/utils/administratorAccess.js", "reason": "administrator access" },
    { "pattern": "src/hooks/useAdministratorAccessStatus.js", "reason": "administrator access" },
    { "pattern": "src/components/features/AdministratorAccess.jsx", "reason": "administrator access" },
    { "pattern": "src/components/pages/AuthPage.jsx", "reason": "sign-in" },
    { "pattern": "src/components/pages/SignInMethodsCard.jsx", "reason": "sign-in" },
    { "pattern": "src/utils/signInMethods.js", "reason": "sign-in" },
    { "pattern": "src/utils/authOffer.js", "reason": "sign-in" },
    { "pattern": "src/utils/memberView*.js", "reason": "member-consented admin view" },
    { "pattern": "src/components/features/MemberViewer.jsx", "reason": "member-consented admin view" },
    { "pattern": "src/utils/limitedLaunch*.js", "reason": "access and membership gate" },
    { "pattern": "src/hooks/useLimitedLaunchAccess.js", "reason": "access and membership gate" },
    { "pattern": "src/constants/beta.js", "reason": "access gate" },
    { "pattern": "src/utils/secretBox.js", "reason": "on-device encryption" },
    { "pattern": "src/utils/privateVault.js", "reason": "on-device identifier vault" },
    { "pattern": "src/utils/phiGuard.js", "reason": "patient identifier guard" },
    { "pattern": "src/utils/identifierGate.js", "reason": "identifier gate" },
    { "pattern": "src/utils/pricing*.js", "reason": "pricing" },
    { "pattern": "src/utils/founding.js", "reason": "pricing" },
    { "pattern": "src/utils/billing.js", "reason": "billing" },
    { "pattern": "src/hooks/useSubscription.js", "reason": "billing" },
    { "pattern": "src/components/pages/PricingModal.jsx", "reason": "pricing" },
    { "pattern": "src/components/pages/LimitedLaunchMembership.jsx", "reason": "pricing" },
    { "pattern": "src/components/pages/CancellationPage.jsx", "reason": "billing" },
    { "pattern": "public/membership-offer.js", "reason": "pricing" }
  ],
  "money_literal_paths": [
    "src/utils/invoice*.js",
    "src/utils/dutyPay.js",
    "src/utils/tax*.js",
    "src/utils/deductions.js",
    "src/utils/forecast.js",
    "src/utils/membershipTiming.js",
    "src/utils/coverageBlocks.js",
    "src/components/features/locum/**",
    "src/content/**",
    "landing/**",
    "public/**"
  ],
  "money_line": "\\$\\s*\\d|\\bprices?\\b|\\bpricing\\b|\\brates?\\b|\\bfees?\\b|\\bamounts?\\b|\\bstipends?\\b|\\bsalar(?:y|ies)\\b|\\bcosts?\\b|\\bcharges?\\b|\\brefunds?\\b|\\bdiscounts?\\b|\\bdollars?\\b|\\bcents?\\b"
}
