{
  "name": "credtemp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-credential-portal.mjs && vite",
    "build": "node scripts/build-credential-portal.mjs && vite build",
    "build:site": "node scripts/build-credential-portal.mjs && vite build --base=/app/ && node scripts/package-site.mjs",
    "build:portal": "node scripts/build-credential-portal.mjs",
    "test:references": "node --experimental-vm-modules scripts/reference-draft.test.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules --test \"tests/**/*.test.mjs\" \"scripts/*.test.mjs\"",
    "lint:hooks": "node --test tests/hooks-rules.test.mjs",
    "pretest": "node scripts/build-credential-portal.mjs",
    "test:admin-db": "python3 tests/admin-operations/postgres-operations.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/clerk-react": "^5.61.6",
    "@supabase/supabase-js": "^2.97.0",
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
