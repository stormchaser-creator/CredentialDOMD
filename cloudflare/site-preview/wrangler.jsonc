// Review-only preview of the packaged public site. See worker.js.
// Build first (npm run build:site), then: npx wrangler deploy -c cloudflare/site-preview/wrangler.jsonc
{
  "name": "credentialdomd-preview",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../site-dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
